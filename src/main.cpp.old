#include <SPI.h>
#include <SD.h>
#include <GxEPD2_3C.h>
#include <Fonts/FreeMonoBold12pt7b.h>

#define SD_CS 2    // D1
#define EPD_CS 3   // D2
#define EPD_DC 4   // D3
#define EPD_RST 5  // D4
#define EPD_BUSY 6 // D5

GxEPD2_3C<GxEPD2_290_C90c, GxEPD2_290_C90c::HEIGHT> display(
    GxEPD2_290_C90c(EPD_CS, EPD_DC, EPD_RST, EPD_BUSY));

void setup()
{
    Serial.begin(115200);
    SPI.begin(7, 8, 9, SD_CS);

    // SD initialisieren
    if (!SD.begin(SD_CS))
    {
        Serial.println("SD init failed!");
        return;
    }

    File f = SD.open("/page.txt", FILE_WRITE);
    if (f)
    {
        f.println("Hello from page.txt");
        f.println("Line 2");
        f.close();
    }

    String content = "";
    f = SD.open("/page.txt");
    if (f)
    {
        while (f.available())
        {
            content += (char)f.read();
        }
        f.close();
    }

    // Auf Display anzeigen
    display.init(115200);

    display.setRotation(1);
    display.setFont(&FreeMonoBold12pt7b);
    display.setTextColor(GxEPD_BLACK);

    display.setFullWindow();
    display.firstPage();
    do
    {
        display.fillScreen(GxEPD_WHITE);
        display.setCursor(0, 20);
        display.print(content);
    } while (display.nextPage());

    Serial.println("Done.");
}

void loop() {}